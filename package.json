{
  "name": "neo-tokyo-underworld-android",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:economy": "node scripts/economy-careers-contract-smoke.mjs",
    "test:casino": "node scripts/casino-contract-smoke.mjs",
    "test:account": "node scripts/account-ui-smoke.mjs",
    "test:community": "node scripts/community-online-smoke.mjs",
    "test:city": "node scripts/city-core-contract-smoke.mjs",
